<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="cda_claim_sequence" model="ir.sequence">
            <field name="name">Reclamos</field>
            <field name="code">cda.claim.sequence</field>
            <field name="prefix"></field>
            <field name="padding">5</field>
            <field name="use_date_range" eval="True" />
            <field name="company_id" eval="False" />
        </record>

        <record id="claim_stage_open" model="cda.claim.stage">
            <field name="name">Abierto</field>
            <field name="sequence">1</field>
            <field name="unattended" eval="True" />
            <field name="closed" eval="False" />
            <field name="fold" eval="False" />
        </record>
        <record id="claim_stage_in_progress" model="cda.claim.stage">
            <field name="name">En progreso</field>
