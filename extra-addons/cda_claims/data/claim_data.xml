            <field name="unattended" eval="False" />
            <field name="closed" eval="False" />
            <field name="fold" eval="False" />
        </record>
        <record id="claim_stage_closed" model="cda.claim.stage">
            <field name="name">Cerrado</field>
            <field name="sequence">4</field>
            <field name="unattended" eval="False" />
            <field name="closed" eval="True" />
