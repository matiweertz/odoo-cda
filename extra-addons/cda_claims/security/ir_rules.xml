<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="rule_cda_claim_company" model="ir.rule">
            <field name="name">cda.claim multi-company</field>
            <field name="model_id" ref="model_cda_claim" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True" />
        </record>
        <record id="rule_cda_claim_attachment_company" model="ir.rule">
            <field name="name">cda.claim.attachment multi-company</field>
            <field name="model_id" ref="model_cda_claim_attachment" />
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True" />
        </record>
    </data>
</odoo>
