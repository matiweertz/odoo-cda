<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="module_category_cda_claims" model="ir.module.category">
        <field name="name">Reclamos</field>
        <field name="description">Acceso al módulo de reclamos.</field>
        <field name="sequence">18</field>
    </record>
    <record id="privilege_cda_claims" model="res.groups.privilege">
        <field name="name">Reclamos</field>
        <field name="category_id" ref="module_category_cda_claims" />
        <field name="sequence">10</field>
    </record>
    <record id="group_cda_claims_user" model="res.groups">
        <field name="name">Operador</field>
        <field name="privilege_id" ref="privilege_cda_claims" />
        <field name="sequence">10</field>
        <field
            name="implied_ids"
            eval="[(4, ref('base.group_user'))]"
        />
    </record>
    <record id="group_cda_claims_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_cda_claims" />
        <field name="sequence">20</field>
        <field name="implied_ids" eval="[(4, ref('group_cda_claims_user'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
</odoo>
