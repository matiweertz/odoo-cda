<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="cda_api_settings_view_form" model="ir.ui.view">
        <field name="name">cda.claim.api.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <form string="API REST">
                <sheet>
                    <div class="alert alert-info" role="alert">
                        Todas las llamadas son JSON-RPC 2.0 y llevan el header
                        <strong>X-Api-Key</strong> con la clave de abajo.
                    </div>
                    <group>
                        <group string="Credenciales" name="cda_api_credentials">
                            <field name="cda_api_key" />
                            <field name="cda_service_user_id" />
                        </group>
                    </group>
                    <group string="Documentación" name="cda_api_docs">
                        <group>
                            <field name="cda_api_docs_url" />
                        </group>
                        <group>
                            <button
                                name="action_cda_open_docs"
                                type="object"
                                string="Ver documentación de la API"
                                class="btn-primary"
                                icon="fa-external-link"
                            />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_cda_save"
                        string="Guardar"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_cda_api_config" model="ir.actions.act_window">
        <field name="name">API REST</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="cda_api_settings_view_form" />
        <field name="target">current</field>
        <field name="path">api-rest</field>
    </record>

    <menuitem
        id="menu_cda_api_config"
        name="API REST"
        action="action_cda_api_config"
        sequence="17"
        web_icon="cda_claims,static/description/icon.png"
        groups="base.group_system"
    />
    <record id="menu_cda_api_config" model="ir.ui.menu">
        <field
            name="group_ids"
            eval="[(6, 0, [ref('base.group_system')])]"
        />
    </record>
</odoo>
