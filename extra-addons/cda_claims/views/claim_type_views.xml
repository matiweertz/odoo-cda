<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="claim_type_view_list" model="ir.ui.view">
        <field name="name">cda.claim.type.list</field>
        <field name="model">cda.claim.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="code" />
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="claim_type_view_form" model="ir.ui.view">
        <field name="name">cda.claim.type.form</field>
        <field name="model">cda.claim.type</field>
        <field name="arch" type="xml">
            <form string="Tipo de reclamo">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archivado"
                        bg_color="bg-danger"
                        invisible="active"
                    />
                    <group>
                        <field name="code" />
                        <field name="name" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="claim_type_view_search" model="ir.ui.view">
        <field name="name">cda.claim.type.search</field>
        <field name="model">cda.claim.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="code" />
                <field name="name" />
                <filter
                    name="archived"
                    string="Archivados"
                    domain="[('active','=',False)]"
                />
            </search>
        </field>
    </record>
    <record id="action_cda_claim_type" model="ir.actions.act_window">
        <field name="name">Tipos de reclamo</field>
        <field name="res_model">cda.claim.type</field>
        <field name="view_mode">list,form</field>
        <field name="path">tipos-reclamo</field>
    </record>
</odoo>