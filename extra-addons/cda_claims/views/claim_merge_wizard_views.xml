<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="claim_merge_wizard_view_form" model="ir.ui.view">
        <field name="name">cda.claim.merge.wizard.form</field>
        <field name="model">cda.claim.merge.wizard</field>
        <field name="arch" type="xml">
            <form string="Combinar reclamos">
                <p class="text-muted">
                    Los reclamos seleccionados se van a archivar y su contenido
                    pasa al reclamo principal.
                </p>
                <group>
                    <field
                        name="claim_ids"
                        widget="many2many_tags"
                        options="{'no_create': True}"
                    />
                    <field
                        name="target_claim_id"
                        options="{'no_create': True}"
                    />
                    <field name="merge_attachments" />
                </group>
                <footer>
                    <button
                        name="action_merge"
                        string="Combinar"
                        type="object"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        special="cancel"
                        class="btn-secondary"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
