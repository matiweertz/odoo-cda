<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- La configuración de la API va como bloque DENTRO del formulario de
         Ajustes, no como vista propia.

         Por qué: ir.ui.view ordena por `create_date desc, id desc` y la vista
         por defecto de un modelo es la última primaria. Una vista primaria
         nueva sobre res.config.settings se apodera de TODA la app Ajustes,
         porque pasa a ser la vista por defecto del modelo.
    -->
    <record id="cda_api_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cda.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app
                    data-string="API REST"
                    string="API REST"
                    name="cda_api"
                    logo="/cda_api/static/description/icon.png"
                >
                    <block title="Acceso" name="cda_api_access">
                        <setting
                            id="cda_api_require_auth"
                            string="Requerir API key"
                            help="Desactivado, la API acepta llamadas sin Authorization y trabaja con el usuario de servicio. Activalo al salir a producción."
                        >
                            <field name="cda_api_require_auth" />
                        </setting>
                        <setting
                            id="cda_api_service_user"
                            string="Usuario de servicio"
                            help="Usuario con el que corre la API cuando no se exige API key. Define el techo de permisos."
                        >
                            <field name="cda_api_service_user_id" />
                        </setting>
                    </block>
                    <block title="Documentación" name="cda_api_docs">
                        <setting
                            id="cda_api_docs_path"
                            string="Ruta de documentación"
                            help="Por defecto /api/v1/docs"
                        >
                            <field
                                name="cda_api_docs_path"
                                placeholder="/api/v1/docs"
                            />
                        </setting>
                        <setting
                            id="cda_api_open_docs"
                            string="Abrir documentación"
                        >
                            <button
                                name="action_cda_open_docs"
                                type="object"
                                string="Ver documentación de la API"
                                class="btn-link"
                                icon="fa-external-link"
                            />
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Acción sin view_id: si se abre, muestra el formulario de Ajustes
         completo (donde ahora vive el bloque API REST), no una vista suelta. -->
    <record id="action_cda_api_config" model="ir.actions.act_window">
        <field name="name">Ajustes de la API</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="path">api-rest</field>
    </record>

    <record id="action_cda_api_docs" model="ir.actions.act_url">
        <field name="name">Documentación</field>
        <field name="url">/api/v1/docs</field>
        <field name="target">new</field>
    </record>
    <record id="action_cda_api_swagger" model="ir.actions.act_url">
        <field name="name">Swagger UI</field>
        <field name="url">/api/v1/docs/swagger</field>
        <field name="target">new</field>
    </record>
    <record id="action_cda_api_openapi" model="ir.actions.act_url">
        <field name="name">OpenAPI JSON</field>
        <field name="url">/api/v1/openapi.json</field>
        <field name="target">new</field>
    </record>

    <!-- El menú deja de ser el formulario de configuración: pasa a ser un
         contenedor con los accesos a la documentación. La configuración se
         toca desde Ajustes, como el resto de Odoo. -->
    <menuitem
        id="menu_cda_api_root"
        name="API REST"
        sequence="17"
        web_icon="cda_api,static/description/icon.png"
        groups="base.group_system"
    />
    <menuitem
        id="menu_cda_api_docs"
        name="Documentación"
        parent="menu_cda_api_root"
        action="action_cda_api_docs"
        sequence="10"
    />
    <menuitem
        id="menu_cda_api_swagger"
        name="Swagger UI"
        parent="menu_cda_api_root"
        action="action_cda_api_swagger"
        sequence="20"
    />
    <menuitem
        id="menu_cda_api_openapi"
        name="OpenAPI JSON"
        parent="menu_cda_api_root"
        action="action_cda_api_openapi"
        sequence="30"
    />
</odoo>
