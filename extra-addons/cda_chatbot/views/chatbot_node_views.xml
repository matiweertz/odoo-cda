<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="chatbot_node_view_list" model="ir.ui.view">
        <field name="name">cda.chatbot.node.list</field>
        <field name="model">cda.chatbot.node</field>
        <field name="arch" type="xml">
            <list string="Árbol" default_order="parent_id, sequence" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="code" />
                <field name="parent_id" />
                <field name="kind" />
                <!-- Editables en línea: sin esto, un nodo de tipo link no tiene
                     dónde cargar la URL sin abrir el formulario. -->
                <field name="url" optional="show" />
                <field name="phone" optional="show" />
                <field name="whatsapp_message" optional="hide" />
                <field name="allow_back" optional="hide" />
                <field name="active" optional="show" />
            </list>
        </field>
    </record>

    <record id="chatbot_node_view_form" model="ir.ui.view">
        <field name="name">cda.chatbot.node.form</field>
        <field name="model">cda.chatbot.node</field>
        <field name="arch" type="xml">
            <form string="Nodo">
                <header>
                    <button
                        name="action_publish"
                        type="object"
                        string="Publicar árbol"
                        class="btn-primary"
                        invisible="not is_root"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field
                                name="name"
                                placeholder="Ej: Tarifas y TelePASE"
                            />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="tarifas.riccheri" />
                            <field name="parent_id" />
                            <field name="kind" />
                            <field name="sequence" />
                            <field name="active" />
                        </group>
                        <group>
                            <field name="path_label" />
                            <field name="is_root" />
                            <field name="allow_back" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Mensaje" name="message">
                            <field
                                name="message"
                                placeholder="Lo que dice el bot al entrar a este nodo"
                            />
                        </page>
                        <page
                            string="Acción"
                            name="action"
                            invisible="kind in ('menu', 'message')"
                        >
                            <group>
                                <field
                                    name="url"
                                    widget="url"
                                    placeholder="https://..."
                                    invisible="kind != 'link'"
                                />
                                <field
                                    name="phone"
                                    widget="phone"
                                    invisible="kind not in ('phone', 'whatsapp')"
                                />
                                <field
                                    name="whatsapp_message"
                                    invisible="kind != 'whatsapp'"
                                    placeholder="Hola, vengo del chat y necesito ayuda con {numero}"
                                />
                            </group>
                            <group invisible="kind != 'claim'">
                                <field name="claim_type_id" />
                                <field name="subtype_id" />
                                <field name="detail_id" />
                            </group>
                        </page>
                        <page
                            string="Opciones"
                            name="options"
                            invisible="kind in ('link', 'phone', 'whatsapp', 'claim')"
                        >
                            <field name="child_ids" context="{'default_parent_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="name" />
                                    <field name="code" />
                                    <field name="kind" />
                                    <field name="url" optional="show" />
                                    <field name="phone" optional="show" />
                                    <field name="active" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="chatbot_node_view_search" model="ir.ui.view">
        <field name="name">cda.chatbot.node.search</field>
        <field name="model">cda.chatbot.node</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="code" />
                <field name="parent_id" />
                <filter
                    name="inactive"
                    string="Inactivos"
                    domain="[('active', '=', False)]"
                />
                <filter
                    name="roots"
                    string="Raíces"
                    domain="[('parent_id', '=', False)]"
                />
                <separator />
                <filter
                    name="group_parent"
                    string="Padre"
                    context="{'group_by': 'parent_id'}"
                />
                <filter
                    name="group_kind"
                    string="Tipo"
                    context="{'group_by': 'kind'}"
                />
            </search>
        </field>
    </record>

    <record id="chatbot_node_action" model="ir.actions.act_window">
        <field name="name">Árbol del chatbot</field>
        <field name="res_model">cda.chatbot.node</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="chatbot_node_view_search" />
        <field name="path">chatbot-arbol</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Armá el árbol del chatbot</p>
            <p>
                El primer nodo que crees será la raíz: el mensaje inicial con
                sus opciones. De ahí en adelante, cada nodo es una opción
                dentro de su padre.
            </p>
        </field>
    </record>
</odoo>
