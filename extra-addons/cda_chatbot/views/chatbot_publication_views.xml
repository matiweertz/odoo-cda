<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="chatbot_publication_view_list" model="ir.ui.view">
        <field name="name">cda.chatbot.publication.list</field>
        <field name="model">cda.chatbot.publication</field>
        <field name="arch" type="xml">
            <list string="Publicaciones" create="0" edit="0">
                <field name="version" />
                <field name="published_on" />
                <field name="user_id" />
                <field name="node_count" />
                <field name="note" />
                <field name="is_current" />
                <button
                    name="action_activate"
                    type="object"
                    string="Poner en línea"
                    icon="fa-upload"
                    invisible="is_current"
                    groups="base.group_system"
                />
            </list>
        </field>
    </record>

    <record id="chatbot_publication_view_form" model="ir.ui.view">
        <field name="name">cda.chatbot.publication.form</field>
        <field name="model">cda.chatbot.publication</field>
        <field name="arch" type="xml">
            <form string="Publicación" create="0" edit="0">
                <header>
                    <button
                        name="action_activate"
                        type="object"
                        string="Poner en línea"
                        class="btn-primary"
                        invisible="is_current"
                        groups="base.group_system"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Versión</span>
                            <field name="version" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="published_on" />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="node_count" />
                            <field name="is_current" />
                            <field name="note" />
                        </group>
                    </group>
                    <separator string="JSON publicado" />
                    <field
                        name="payload"
                        widget="ace"
                        options="{'mode': 'json'}"
                        readonly="1"
                        nolabel="1"
                    />
                </sheet>
            </form>
        </field>
    </record>

    <record id="chatbot_publication_action" model="ir.actions.act_window">
        <field name="name">Publicaciones</field>
        <field name="res_model">cda.chatbot.publication</field>
        <field name="view_mode">list,form</field>
        <field name="path">chatbot-publicaciones</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Todavía no publicaste el árbol</p>
            <p>
                Cada publicación es una foto inmutable. El sitio consume la que
                está marcada como activa.
            </p>
        </field>
    </record>
</odoo>
